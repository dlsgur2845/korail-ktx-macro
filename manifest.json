{
  "manifest_version": 3,
  "name": "KTX 잔여석 매크로",
  "version": "1.5.3",
  "description": "코레일 KTX 잔여석 조회, 정차 안내 확인 및 예매 요청 보조",
  "permissions": [
    "notifications",
    "debugger",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.korail.com/ticket/*",
        "https://korail.com/ticket/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://ntfy.sh/*"
  ],
  "options_ui": {
    "page": "phone.html",
    "open_in_tab": true
  }
}
